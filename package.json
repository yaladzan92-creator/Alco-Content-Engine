{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "cross-env ALCO_NEXT_DIST_DIR=.next-build NODE_ENV=production next build",
    "start": "cross-env ALCO_NEXT_DIST_DIR=.next-build next start",
